# AxorOS staging environment template
# Real staging secrets will be injected by the approved secrets/deployment systems.
# Never commit real credentials.

AXOROS_ENV=staging
AXOROS_API_PORT=3001
AXOROS_CONTROL_CENTER_URL=https://staging.example.invalid

# Public browser configuration only. Replace at deployment time.
VITE_AXOROS_API_URL=https://api-staging.example.invalid
