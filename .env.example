# AxorOS environment template.
# Never place real credentials in this file.
AXOROS_ENV=development
AXOROS_API_PORT=3001
AXOROS_CONTROL_CENTER_URL=http://localhost:5173

# Optional external integrations. Store real secrets in Infisical, not this file.
# GEMINI_API_KEY=
# AXOROS_GMAIL_CLIENT_ID=
# AXOROS_GMAIL_CLIENT_SECRET=
# AXOROS_GMAIL_REFRESH_TOKEN=
# AXOROS_GMAIL_IDENTITY_ADDRESSES=

# Payment integration defaults to the deterministic sandbox.
# Configuring a Paystack secret alone does not activate Paystack.
# AXOROS_PAYSTACK_SECRET_KEY=
# AXOROS_PAYMENT_INTEGRATION=paystack

# Added in later Phase 6 steps:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# INFISICAL_PROJECT_ID=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# BETTER_STACK_SOURCE_TOKEN=
