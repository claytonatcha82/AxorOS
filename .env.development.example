# AxorOS local development environment
# Copy values into an ignored local environment file when configuration is required.
# Never commit real credentials.

AXOROS_ENV=development
AXOROS_API_PORT=3001
AXOROS_CONTROL_CENTER_URL=http://localhost:5173

# Public browser configuration only. Never place secrets in VITE_* variables.
VITE_AXOROS_API_URL=http://localhost:3001
