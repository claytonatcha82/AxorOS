# AxorOS production environment template
# Real production secrets will be injected by the approved secrets/deployment systems.
# Never commit real credentials.

AXOROS_ENV=production
AXOROS_API_PORT=3001
AXOROS_CONTROL_CENTER_URL=https://app.example.invalid

# Public browser configuration only. Replace at deployment time.
VITE_AXOROS_API_URL=https://api.example.invalid

# Production payment configuration.
# Inject the real secret through Infisical/Railway after Paystack approval; never commit it.
AXOROS_PAYMENT_INTEGRATION=paystack
AXOROS_PAYSTACK_SECRET_KEY=
